{
  "$schema": "gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Standard-Berechtigungen der CNC-Craft App",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "**" }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        { "path": "**" }
      ]
    },
    "fs:allow-read-file"
  ]
}